# Copy to .env and replace the Oracle / LLM placeholders for local use.
ORACLE_DSN=host:port/service_name
ORACLE_USER=replace_me
ORACLE_PASSWORD=replace_me
OPENAI_API_KEY=replace_me
SERVICE_AUTH_TOKEN=replace_with_same_random_secret_in_ui_and_service_a
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional local state and catalog locations
STATE_DIR=artifacts/v2
# Uncomment to override the paths derived from STATE_DIR.
# CHECKPOINT_DB_PATH=artifacts/v2/checkpoints.sqlite
# APP_STATE_DB_PATH=artifacts/v2/app_state.sqlite
CATALOG_DIR=config/aml_catalogs
AGENT_RECURSION_LIMIT=25

# Optional LangSmith tracing (keys are never logged)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=replace_me
LANGCHAIN_PROJECT=ai-aml-agent

# Optional model settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini
# Unset uses the provider default.
# LLM_MAX_TOKENS=
# MAX_AGENT_ITERATIONS is reserved; AGENT_RECURSION_LIMIT is authoritative.
MAX_AGENT_ITERATIONS=25
MAX_VALIDATION_RETRIES=3
