# Copy to .env and replace the Oracle / LLM placeholders for local use.
ORACLE_DSN=host:port/service_name
ORACLE_USER=replace_me
ORACLE_PASSWORD=replace_me
# ORACLE_* remains the application registry role for existing deployments.
# Generated SQL, schema retrieval, and shadow execution require an independent
# DWH reader role; no fallback to ORACLE_* occurs. SHADOW_ORACLE_* is an explicit
# legacy alias for this DWH role.
# DWH_ORACLE_DSN=host:port/service_name
# DWH_ORACLE_USER=read_only_user
# DWH_ORACLE_PASSWORD=replace_me
# DWH_ORACLE_SCHEMA=optional_default_schema
# DWH_ORACLE_POOL_MIN=1
# DWH_ORACLE_POOL_MAX=4
# ORACLE_REGISTRY_SCHEMA=optional_registry_owner
# ORACLE_REGISTRY_NAMESPACE=PIO_AML_AGENT
# Runtime provisioning is disabled. Enable only for a separately authorized
# schema-provisioning operation.
# ORACLE_REGISTRY_SCHEMA_PROVISIONING_ENABLED=false
OPENAI_API_KEY=replace_me
SERVICE_AUTH_TOKEN=replace_with_same_random_secret_in_ui_and_service_a
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional local state and catalog locations
STATE_DIR=artifacts/v2
# Uncomment to override the paths derived from STATE_DIR.
# CHECKPOINT_DB_PATH=artifacts/v2/checkpoints.sqlite
# APP_STATE_DB_PATH=artifacts/v2/app_state.sqlite
CATALOG_DIR=config/aml_catalogs
AGENT_RECURSION_LIMIT=25

# Optional LangSmith tracing (keys are never logged)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=replace_me
LANGCHAIN_PROJECT=ai-aml-agent

# Optional model settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini
# Unset uses the provider default.
# LLM_MAX_TOKENS=
# DWH SQL role overrides inherit the corresponding LLM_* defaults when unset.
# DWH_SQL_GENERATOR_PROVIDER=
# DWH_SQL_GENERATOR_MODEL=
# DWH_SQL_CRITIC_PROVIDER=
# DWH_SQL_CRITIC_MODEL=
# DWH_SQL_SUMMARIZER_PROVIDER=
# DWH_SQL_SUMMARIZER_MODEL=
# DWH_SQL_EMBEDDINGS_PROVIDER=openai
# DWH_SQL_EMBEDDINGS_MODEL=text-embedding-3-small
# DWH_SQL_EMBEDDINGS_DIMENSION=1536
# DWH_SQL_EMBEDDINGS_FINGERPRINT=
# DWH_SQL_EMBEDDINGS_DEVICE=cpu
# Chroma schema indexes are tenant-scoped and must be built with the selected
# embedding identity; never point at an unversioned legacy index.
# DWH_SQL_INDEX_INSTITUTION_ID=<tenant-scope-for-owner-run-index-build>
# DWH_SQL_CONNECT_TIMEOUT_SECONDS=10
# DWH_SQL_READ_TIMEOUT_SECONDS=120
# DWH_SQL_DEADLINE_SECONDS=180
# DWH_SQL_RETRY_BUDGET=2
# DWH_SQL_MAX_ATTEMPTS=3
# DWH_SQL_OUTPUT_TOKEN_LIMIT=4096
# DWH_SQL_CONTEXT_BUDGET=32768
# DWH_SQL_MAX_CANDIDATE_ROWS=100
# DWH_SQL_ALLOWED_SCHEMAS=
# DWH_SQL_ALLOWED_OBJECTS=
# B8 acceptance validation is disabled by default and must use a dedicated
# read-only account. These settings never fall back to ORACLE_* or SHADOW_ORACLE_*.
# DWH_SQL_ACCEPTANCE_ENABLED=false
# DWH_SQL_ACCEPTANCE_DSN=
# DWH_SQL_ACCEPTANCE_USER=
# DWH_SQL_ACCEPTANCE_PASSWORD=
# DWH_SQL_ACCEPTANCE_RESOURCE_PLAN=
# DWH_SQL_OPENAI_API_KEY=
# DWH_SQL_COHERE_API_KEY=
# DWH_SQL_SAMBANOVA_API_KEY=
# DWH_SQL_OPENROUTER_API_KEY=
# DWH_SQL_BASE_URL=
# DWH_SQL_TOOL_CALLING=true
# DWH_SQL_SCHEMA_TABLES_COLLECTION=schema_tables
# DWH_SQL_SCHEMA_COLUMNS_COLLECTION=schema_columns
# DWH_SQL_EXPERIENCE_COLLECTION=experience_templates
# DWH_SQL_CHROMA_PERSIST_DIR=
# DWH_SQL_SCHEMA_TABLES_K=20
# DWH_SQL_SCHEMA_COLUMNS_K=40
# DWH_SQL_EXPERIENCE_K=5
# DWH_SQL_RETRIEVAL_THRESHOLD=0.6
# DWH_SQL_SEMANTIC_WEIGHT=0.5
# DWH_SQL_GRAPH_WEIGHT=0.5
# DWH_SQL_NEO4J_ENABLED=false
# DWH_SQL_NEO4J_URI=
# DWH_SQL_NEO4J_USER=
# DWH_SQL_NEO4J_PASSWORD=
# DWH_SQL_NEO4J_TIMEOUT_SECONDS=2
# DWH_SQL_NEO4J_MAX_RESULTS=100
# MAX_AGENT_ITERATIONS is reserved; AGENT_RECURSION_LIMIT is authoritative.
MAX_AGENT_ITERATIONS=25
MAX_VALIDATION_RETRIES=3
# Optional explicit classification; empty by default. Never broadens the object allowlist.
# DWH_SQL_INDEX_INTERNAL_OBJECTS=[]
